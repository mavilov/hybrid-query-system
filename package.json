{
    "name": "hybrid-query-system",
    "version": "1.0.0",
    "description": "Hybrid search engine that can answer specific user questions about software vulnerabilities.",
    "keywords": [
        "assignment",
        "test"
    ],
    "homepage": "https://github.com/mavilov/hybrid-query-system#readme",
    "bugs": {
        "url": "https://github.com/mavilov/hybrid-query-system/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/mavilov/hybrid-query-system.git"
    },
    "license": "ISC",
    "author": "Maksim Avilov",
    "type": "module",
    "main": "src/start.js",
    "scripts": {
        "test": "node --test tests/**/*test.js",
        "coverage": "c8 --reporter=lcov --reporter=text --reporter=html node --test tests/**/*test.js",
        "prettier:test": "prettier --check ./**/*.{js,json,md}",
        "prettier:fix": "prettier --write ./**/*.{js,json,md}",
        "lint": "eslint .",
        "develop": "node --watch src/start.js",
        "setup": "mkdir data || true && node src/initial-data-setup/dataSetup.js",
        "resetData": "rm -rf data || true && npm run setup",
        "start": "node src/start.js"
    },
    "dependencies": {
        "better-sqlite3": "^12.4.6",
        "chalk": "^5.6.2",
        "http-status-codes": "^2.3.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.1",
        "c8": "^10.1.3",
        "eslint": "^9.39.1",
        "globals": "^17.0.0",
        "prettier": "^3.6.2"
    }
}
